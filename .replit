run = "npm start"
modules = ["nodejs-20", "postgresql-16"]
hidden = [".config", "package-lock.json"]

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[deployment]
run = ["sh", "-c", "npm start"]
build = ["sh", "-c", "npm install && npm run build"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80
